# ── GCP Core ──────────────────────────────────────────────────────────────
GCP_PROJECT_ID=your-gcp-project-id
GCP_REGION=southamerica-east1
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account-key.json

# ── Dataflow Pipeline ──────────────────────────────────────────────────────
DATAFLOW_JOB_ID=2026-09-25_00_00_00-123456789
DATAFLOW_JOB_NAME_PREFIX=pipeline-events-

# ── Pub/Sub Messaging ──────────────────────────────────────────────────────
PUBSUB_SUBSCRIPTION_ID=pipeline-events-sub
PUBSUB_TOPIC_ID=pipeline-events

# ── BigQuery Warehouse ─────────────────────────────────────────────────────
BQ_DATASET_ID=pipeline_data
BQ_TABLE_ID=events
BQ_BILLING_EXPORT_DATASET=billing_export
BQ_BILLING_EXPORT_TABLE=gcp_billing_export_v1_000000_000000_000000

# ── Cloud Logging ─────────────────────────────────────────────────────────
LOG_FILTER_SEVERITY_MIN=INFO
LOG_STREAM_BATCH_SIZE=5
LOG_POLL_INTERVAL_SECONDS=1.8

# ── Vertex AI / Google Agent Development Kit (ADK) ─────────────────────────
VERTEX_AI_LOCATION=us-central1
GEMINI_SUPERVISOR_MODEL=gemini-2.0-flash
GEMINI_ANALYST_MODEL=gemini-1.5-pro
ADK_APP_NAME=gcp-pipeline-monitor

# ── Metrics Thresholds ────────────────────────────────────────────────────
METRICS_REFRESH_INTERVAL_SECONDS=2
LATENCY_P99_WARNING_MS=400
LATENCY_P99_ERROR_MS=500
BACKLOG_WARNING_MESSAGES=5000
BACKLOG_ERROR_MESSAGES=20000

# ── FinOps & Cost Optimization ─────────────────────────────────────────────
FINOPS_DAILY_COST_ALERT_USD=100.0
FINOPS_COST_SPIKE_MULTIPLIER=1.2
FINOPS_REFRESH_INTERVAL_SECONDS=300

# ── IAM Baseline & Security Audit ──────────────────────────────────────────
IAM_BASELINE_FILE=./config/iam_baseline.yaml
IAM_SCAN_INTERVAL_SECONDS=600

# ── Backend Server (FastAPI / Uvicorn) ────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,https://dashboard.internal.example.com

# ── Frontend (Vite / React) ────────────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:8000

# ── Observability & OpenTelemetry ──────────────────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
OTEL_SERVICE_NAME=gcp-pipeline-dashboard-backend
LOG_LEVEL=INFO
