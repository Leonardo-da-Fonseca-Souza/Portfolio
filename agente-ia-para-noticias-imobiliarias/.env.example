# ==============================================================================
# CONFIGURAÇÃO DE VARIÁVEIS DE AMBIENTE - EXEMPLO
# ==============================================================================
# Copie este arquivo para um arquivo chamado '.env' na mesma pasta ou na pasta 'backend/'
# e preencha as variáveis abaixo com valores adequados para o seu ambiente.

# Configurações do Banco de Dados PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=imoveisai
DB_USER=postgres
DB_PASSWORD=sua_senha_segura_aqui

# Configurações da API do Google Gemini
GEMINI_API_KEY=sua_chave_de_api_gemini_aqui
